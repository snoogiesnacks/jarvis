diff --git a/bridge/net.mjs b/bridge/net.mjs
index 51d7990..c69c8f1 100644
--- a/bridge/net.mjs
+++ b/bridge/net.mjs
@@ -82,6 +82,11 @@ export function blockedAddress(ip) {
     return false
   }
 
+  // Fail closed: from here on only a well-formed IPv6 address can be allowed.
