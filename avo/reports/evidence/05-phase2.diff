    80	  for (const re of PATTERNS) {
    81	    const m = re.exec(sentence)
    82	    if (!m) continue
    83	    const kind = classifyMatch(sentence, m)
    84	    if (!best || RANK[kind] > RANK[best.kind]) best = { kind, phrase: m[0], sentence }
    85	  }
    86	  return best
    87	}
